---
export const prerender = false;

import { readFileSync } from 'fs';
import { resolve } from 'path';

const MDX_FILE = resolve(process.cwd(), 'src/content/blog/yakushima-jomon-sugi.mdx');
const content = readFileSync(MDX_FILE, 'utf-8');

// --- Photo position detection ---
function getPosition(content: string, imageVar: string): 'left' | 'right' {
  const lines = content.split('\n');
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].trim() !== '<div class="side-by-side">') continue;
    let containsImage = false, depth = 1;
    for (let j = i + 1; j < lines.length; j++) {
      const t = lines[j].trim();
      if (t.startsWith('<div')) depth++;
      if (t === '</div>') { depth--; if (!depth) break; }
      if (lines[j].includes(`src={${imageVar}}`)) { containsImage = true; break; }
    }
    if (!containsImage) continue;
    for (let j = i + 1; j < lines.length; j++) {
      const t = lines[j].trim();
      if (!t) continue;
      return t.startsWith('<Image') ? 'left' : 'right';
    }
  }
  return 'left';
}

// --- Text extraction ---
function getPInSideBySide(content: string, imageVar: string): string {
  const lines = content.split('\n');
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].trim() !== '<div class="side-by-side">') continue;
    let containsImage = false, blockEnd = -1, depth = 1;
    for (let j = i + 1; j < lines.length; j++) {
      const t = lines[j].trim();
      if (t.startsWith('<div')) depth++;
      if (t === '</div>') { depth--; if (!depth) { blockEnd = j; break; } }
      if (lines[j].includes(`src={${imageVar}}`)) containsImage = true;
    }
    if (!containsImage || blockEnd === -1) continue;
    for (let j = i + 1; j < blockEnd; j++) {
      const t = lines[j].trim();
      if (t.startsWith('<p>') && t.endsWith('</p>')) return t.slice(3, -4);
    }
  }
  return '';
}

function getDivParagraphs(content: string, imageVar: string): string {
  const lines = content.split('\n');
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].trim() !== '<div class="side-by-side">') continue;
    let containsImage = false, blockEnd = -1, depth = 1;
    for (let j = i + 1; j < lines.length; j++) {
      const t = lines[j].trim();
      if (t.startsWith('<div')) depth++;
      if (t === '</div>') { depth--; if (!depth) { blockEnd = j; break; } }
      if (lines[j].includes(`src={${imageVar}}`)) containsImage = true;
    }
    if (!containsImage || blockEnd === -1) continue;
    for (let j = i + 1; j < blockEnd; j++) {
      if (!lines[j].trim().startsWith('<div')) continue;
      let innerEnd = -1, d = 1;
      for (let k = j + 1; k < blockEnd; k++) {
        const t = lines[k].trim();
        if (t.startsWith('<div')) d++;
        if (t === '</div>') { d--; if (!d) { innerEnd = k; break; } }
      }
      if (innerEnd === -1) continue;
      const texts: string[] = [];
      for (let k = j + 1; k < innerEnd; k++) {
        const t = lines[k].trim();
        if (t.startsWith('<p>') && t.endsWith('</p>')) texts.push(t.slice(3, -4));
      }
      return texts.join('\n\n');
    }
  }
  return '';
}

function getKneeText(content: string): string {
  const lines = content.split('\n');
  for (let i = 0; i < lines.length; i++) {
    if (!lines[i].includes('text-with-photos')) continue;
    for (let j = i + 1; j < lines.length; j++) {
      const t = lines[j].trim();
      if (t === '</div>') break;
      if (t.startsWith('<p>') && t.endsWith('</p>')) return t.slice(3, -4);
    }
  }
  return '';
}

function getIntroText(content: string): string {
  const lines = content.split('\n');
  const intro: string[] = [];
  let pastImports = false;
  for (const line of lines) {
    if (line.startsWith('import ')) { pastImports = true; continue; }
    if (!pastImports) continue;
    if (line.startsWith('## ')) break;
    if (line.trim().startsWith('<')) continue;
    intro.push(line);
  }
  return intro.join('\n').trim();
}

function getFooterText(content: string): string {
  const lines = content.split('\n');
  for (let i = lines.length - 1; i >= 0; i--) {
    const t = lines[i].trim();
    if (t && !t.startsWith('<') && !t.startsWith('---') && !t.startsWith('import')) return t;
  }
  return '';
}

const photoSections = [
  { id: 'tunnel',       label: 'トンネルの写真' },
  { id: 'wilson2',      label: 'ウィルソン株のハート' },
  { id: 'jomonSugi',    label: '縄文杉' },
  { id: 'namelessSugi', label: '名もなき屋久杉' },
  { id: 'doobop',       label: 'Doo-Bop Hoody' },
].map(s => ({ ...s, position: getPosition(content, s.id) }));

const textBlocks = [
  { id: 'intro',    label: 'イントロ（冒頭の文章）',            text: getIntroText(content),                    rows: 8 },
  { id: 'tunnel',   label: 'トンネル写真の説明',                text: getPInSideBySide(content, 'tunnel'),       rows: 4 },
  { id: 'wilson',   label: 'ウィルソン株の説明',                text: getPInSideBySide(content, 'wilson2'),      rows: 4 },
  { id: 'jomon',    label: '縄文杉の説明',                      text: getPInSideBySide(content, 'jomonSugi'),    rows: 4 },
  { id: 'knee',     label: '下山時の注意',                      text: getKneeText(content),                      rows: 4 },
  { id: 'nameless', label: '名もなき屋久杉（段落を空行で区切る）', text: getDivParagraphs(content, 'namelessSugi'), rows: 5 },
  { id: 'doobop',   label: 'Doo-Bop Hoodyの説明',              text: getDivParagraphs(content, 'doobop'),       rows: 4 },
  { id: 'footer',   label: '最後の一文',                        text: getFooterText(content),                    rows: 2 },
];

const updated = Astro.url.searchParams.get('updated');
const tab = Astro.url.searchParams.get('tab') ?? 'layout';
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>記事管理</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", sans-serif; max-width: 640px; margin: 40px auto; padding: 0 20px; background: #fffdf9; color: #333; }
    h1 { color: #5c3d1e; font-size: 1.3em; margin-bottom: 4px; }
    .subtitle { color: #888; font-size: 0.9em; margin-bottom: 20px; }
    .tabs { display: flex; gap: 8px; margin-bottom: 24px; }
    .tab { padding: 8px 20px; border-radius: 20px; border: 2px solid #5c3d1e; background: white; color: #5c3d1e; font-size: 0.95em; cursor: pointer; text-decoration: none; font-family: inherit; }
    .tab.active { background: #5c3d1e; color: white; }
    /* Layout cards */
    .card { background: white; border: 1px solid #e0d0b8; border-radius: 12px; padding: 18px 20px; margin: 12px 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .info .label { font-size: 1em; font-weight: bold; color: #5c3d1e; }
    .pos { font-size: 0.85em; color: #666; margin-top: 6px; display: flex; align-items: center; gap: 8px; }
    .badge { background: #5c3d1e; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.8em; }
    /* Text blocks */
    .text-block { background: white; border: 1px solid #e0d0b8; border-radius: 12px; padding: 18px 20px; margin: 14px 0; }
    .text-block label { font-weight: bold; color: #5c3d1e; font-size: 0.95em; display: block; margin-bottom: 8px; }
    textarea { width: 100%; border: 1px solid #ccc; border-radius: 8px; padding: 10px 12px; font-size: 0.9em; font-family: "Hiragino Kaku Gothic ProN", sans-serif; resize: vertical; line-height: 1.7; }
    textarea:focus { outline: none; border-color: #5c3d1e; }
    /* Buttons */
    .btn { background: #5c3d1e; color: white; border: none; border-radius: 8px; padding: 10px 18px; font-size: 0.95em; cursor: pointer; font-family: inherit; white-space: nowrap; }
    .btn:hover { background: #7a5530; }
    .btn-row { display: flex; justify-content: flex-end; margin-top: 10px; }
    /* Success */
    .success { background: #e8f5e9; color: #2e7d32; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.95em; }
    .preview-link { display: inline-block; margin-top: 24px; color: #5c3d1e; font-size: 0.95em; }
    .section { display: none; }
    .section.active { display: block; }
  </style>
</head>
<body>
  <h1>✏️ 記事管理</h1>
  <p class="subtitle">縄文杉コースの記事</p>

  {updated === '1' && (
    <div class="success">✅ 保存しました。記事でCmd+Shift+Rを押して確認してください。</div>
  )}

  <div class="tabs">
    <a class={`tab ${tab === 'layout' ? 'active' : ''}`} href="/admin?tab=layout">📸 写真の配置</a>
    <a class={`tab ${tab === 'text' ? 'active' : ''}`} href="/admin?tab=text">✏️ 文章の編集</a>
  </div>

  <!-- 写真の配置タブ -->
  <div class={`section ${tab === 'layout' ? 'active' : ''}`}>
    {photoSections.map(s => (
      <div class="card">
        <div class="info">
          <div class="label">{s.label}</div>
          <div class="pos">
            {s.position === 'left'
              ? <><span>📸　文</span><span class="badge">写真が左</span></>
              : <><span>文　📸</span><span class="badge">写真が右</span></>
            }
          </div>
        </div>
        <form method="POST" action="/api/flip-photo">
          <input type="hidden" name="section" value={s.id} />
          <button type="submit" class="btn">↔ 左右を入れ替える</button>
        </form>
      </div>
    ))}
  </div>

  <!-- 文章の編集タブ -->
  <div class={`section ${tab === 'text' ? 'active' : ''}`}>
    {textBlocks.map(block => (
      <div class="text-block">
        <form method="POST" action="/api/update-text">
          <input type="hidden" name="blockId" value={block.id} />
          <label>{block.label}</label>
          <textarea name="text" rows={block.rows}>{block.text}</textarea>
          <div class="btn-row">
            <button type="submit" class="btn">💾 保存する</button>
          </div>
        </form>
      </div>
    ))}
  </div>

  <a class="preview-link" href="/blog/yakushima-jomon-sugi" target="_blank">記事を確認する →</a>
</body>
</html>
