---
import { getCollection } from 'astro:content';
import HomeContent from '../components/HomeContent.astro';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts.slice(0, 5).map((p) => ({
	date: `${p.data.pubDate.getFullYear()}.${p.data.pubDate.getMonth() + 1}.${p.data.pubDate.getDate()}`,
	cat: p.data.tags?.[0] ?? '',
	title: p.data.title,
	url: `/blog/${p.id}/`,
}));

const counts = new Map();
for (const p of posts) for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
const categories = [...counts.entries()]
	.sort((a, b) => b[1] - a[1])
	.map(([name, count]) => ({ name, count }));

const blogData = {
	profile: {
		name: 'Hachi',
		age: 53,
		height: 162.5,
		bio: 'アクティブミニマリスト',
		summits: 60,
		months: 36,
		tagline: '信頼できるギアをひとつ選んで山へ行く',
		title: '一山一会',
		subtitle: '50代の山支度',
	},
	posts: latest,
	categories,
};
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <!-- Google tag (gtag.js) — 本番サイトのみ（localhostでは計測しない） -->
  <script is:inline>
    if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-FTKT91GLD3';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FTKT91GLD3');
    }
  </script>
  <title>一山一会 — 50代の山支度</title>
  <link rel="canonical" href="https://ichizanichie.com/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="description" content="50代・ソロで山を歩く「一山一会」の記録。富士山・屋久島・立山・くじゅうの山行記と、使い込んだ登山ギアのレビューをまとめています。" />
  <meta property="og:title" content="一山一会 — 50代の山支度" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://ichizanichie.com/" />
  <meta property="og:site_name" content="一山一会：50代の山支度" />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; overflow-x: hidden; }
    @media (max-width: 600px) {
      #root > div {
        padding-left: 16px !important;
        padding-right: 16px !important;
      }
    }
    body {
      background: #efe9df;
      color: #3a2e26;
      font-family: 'Noto Sans JP', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a { color: inherit; }
    ::selection { background: #a87842; color: #fff; }
  </style>
</head>
<body>
  <HomeContent posts={latest} />
</body>
</html>
