---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 公開済み記事を新しい順に取得
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 中岳を先頭記事（最新リール）として取得
const featuredPost = allPosts.find((p) => p.id === 'nakadake-miyamakirishima');
const otherPosts = allPosts.filter((p) => p.id !== 'nakadake-miyamakirishima');

// サムネイル画像を最適化
async function optimizeThumb(src: Parameters<typeof getImage>[0]['src'] | undefined) {
  if (!src) return null;
  return await getImage({ src, width: 600, height: 400, format: 'webp' });
}

const featuredImg = featuredPost?.data.heroImage
  ? await getImage({ src: featuredPost.data.heroImage, width: 900, height: 600, format: 'webp' })
  : null;

const thumbs = await Promise.all(
  otherPosts.map((p) => optimizeThumb(p.data.heroImage))
);
---

<html lang="ja">
  <head>
    <BaseHead
      title="記事リンク集 | 一山一会"
      description="一山一会のブログ記事一覧です。登山レポートや山道具レビューをまとめています。"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        background: linear-gradient(to bottom, #fffdf9, #e8d8c0) no-repeat fixed;
        background-size: 100% 100%;
        color: rgb(var(--gray-dark));
        font-size: 20px;
        line-height: 1.7;
      }

      .page-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 1.5em 1em 3em;
      }

      .page-title {
        text-align: center;
        font-size: 1em;
        color: rgb(var(--gray));
        margin: 0 0 1.5em;
        letter-spacing: 0.05em;
      }

      /* ── 特集カード ── */
      .featured-card {
        display: block;
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        text-decoration: none;
        color: #fff;
        margin-bottom: 2em;
        box-shadow: 0 4px 20px rgba(0,0,0,0.18);
        min-height: 240px;
      }

      .featured-card img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        display: block;
        border-radius: 0;
      }

      .featured-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.72) 50%, rgba(0,0,0,0.1) 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.2em 1.2em 1.4em;
      }

      .featured-badge {
        display: inline-block;
        background: #c8622a;
        color: #fff;
        font-size: 0.65em;
        font-weight: bold;
        letter-spacing: 0.08em;
        padding: 0.25em 0.7em;
        border-radius: 4px;
        margin-bottom: 0.6em;
        align-self: flex-start;
      }

      .featured-title {
        font-size: 1.05em;
        font-weight: bold;
        line-height: 1.45;
        color: #fff;
        text-shadow: 0 1px 4px rgba(0,0,0,0.5);
      }

      /* ── 記事リスト ── */
      .post-list {
        display: flex;
        flex-direction: column;
        gap: 0;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .post-list li {
        border-bottom: 1px solid rgb(var(--gray-light));
      }

      .post-list li:first-child {
        border-top: 1px solid rgb(var(--gray-light));
      }

      .post-row {
        display: flex;
        align-items: center;
        gap: 0.9em;
        padding: 0.85em 0.2em;
        text-decoration: none;
        color: rgb(var(--gray-dark));
        transition: background 0.15s;
        border-radius: 8px;
      }

      .post-row:hover {
        background: rgba(var(--gray-light), 0.5);
      }

      .post-thumb {
        width: 80px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
        display: block;
      }

      .post-thumb-placeholder {
        width: 80px;
        height: 60px;
        border-radius: 8px;
        flex-shrink: 0;
        background: rgb(var(--gray-light));
      }

      .post-info {
        flex: 1;
        min-width: 0;
      }

      .post-info-title {
        font-size: 0.85em;
        line-height: 1.45;
        font-weight: bold;
        color: #3a2e26;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .post-arrow {
        color: rgb(var(--gray));
        font-size: 1em;
        flex-shrink: 0;
        padding-left: 0.2em;
      }

      @media (max-width: 600px) {
        body { font-size: 18px; }
        .featured-card img { height: 220px; }
        .featured-title { font-size: 0.95em; }
        .post-thumb { width: 72px; height: 54px; }
        .post-thumb-placeholder { width: 72px; height: 54px; }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <div class="page-wrap">
        <p class="page-title">— 記事一覧 —</p>

        {featuredPost && (
          <a class="featured-card" href={`/blog/${featuredPost.id}/`}>
            {featuredImg
              ? <img src={featuredImg.src} alt={featuredPost.data.title} width="900" height="600" />
              : <div style="height:300px; background:#c8d8c0;" />
            }
            <div class="featured-overlay">
              <span class="featured-badge">最新リール</span>
              <span class="featured-title">{featuredPost.data.title}</span>
            </div>
          </a>
        )}

        <ul class="post-list">
          {otherPosts.map((post, i) => {
            const thumb = thumbs[i];
            return (
              <li>
                <a class="post-row" href={`/blog/${post.id}/`}>
                  {thumb
                    ? <img class="post-thumb" src={thumb.src} alt="" width="80" height="60" />
                    : <div class="post-thumb-placeholder" />
                  }
                  <div class="post-info">
                    <div class="post-info-title">{post.data.title}</div>
                  </div>
                  <span class="post-arrow">›</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </main>
    <Footer />
  </body>
</html>
